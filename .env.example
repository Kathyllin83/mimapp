DATABASE_URL=postgresql://mimapp:mimapp@127.0.0.1:5433/mimapp
SESSION_COOKIE=mima_session
APP_ORIGIN=http://localhost:5173
# Produção (Railway): NODE_ENV=production, ADMIN_PASSWORD (12+ caracteres) e ADMIN_EMAIL, usados só por `npm run db:seed-admin`
ADMIN_EMAIL=root@mima.local
ADMIN_PASSWORD=
GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-20b
GROQ_ADVANCED_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
AI_DAILY_LIMIT=10
AI_FREE_MONTHLY_LIMIT=3
AI_IP_HOURLY_LIMIT=20
AI_GLOBAL_DAILY_LIMIT=5000
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ROBOT_CONTACT=
ROBOT_INTERVAL_MIN=30
# Código de associado da Amazon (reserva; o valor configurado em /perfil tem prioridade)
AMAZON_ASSOCIATE_TAG=
# API de afiliados da Shopee (precisa de aprovação no programa); não coloque estes valores em conversas
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=
